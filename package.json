{
  "name": "applet",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "main": "server.cjs",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build",
    "build:server": "esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=server.cjs",
    "build:all": "npm run build && npm run build:server",
    "start": "node server.cjs",
    "clean": "rm -rf dist server.js server.cjs server.cjs.map",
    "lint": "tsc --noEmit",
    "supabase:verify": "tsx scripts/verify-supabase-leaves.ts",
    "supabase:migrate-leaves": "tsx scripts/migrate-leaves-to-leave-requests.ts --sync-supabase",
    "supabase:sync": "tsx scripts/sync-leave-all-to-supabase.ts",
    "supabase:sync:requests": "tsx scripts/sync-leave-requests-to-supabase.ts",
    "supabase:sync:allocations": "tsx scripts/sync-leave-allocations-to-supabase.ts",
    "supabase:sync:settlements": "tsx scripts/sync-leave-settlements-to-supabase.ts",
    "leaves:purge-legacy": "tsx scripts/purge-legacy-leaves-collection.ts",
    "purge:demo": "tsx scripts/purge-demo-data.ts",
    "employees:heal-cross-tenant": "tsx scripts/run-employee-cross-tenant-self-heal-admin.ts",
    "pam:seed-overlay": "tsx scripts/seed-pam-overlay-settings.ts",
    "pam:export-overlay": "tsx scripts/seed-pam-overlay-settings.ts --export",
    "documents:sync-archive": "tsx scripts/sync-employee-documents-archive.ts",
    "fanar:probe": "tsx scripts/probe-fanar-company-admin.ts",
    "fanar:list-employees": "tsx scripts/list-fanar-employees-admin.ts"
  },
  "dependencies": {
    "@fontsource/cairo": "^5.3.0",
    "@google/genai": "^2.4.0",
    "@pdf-lib/fontkit": "^1.1.1",
    "@supabase/supabase-js": "^2.112.3",
    "@tailwindcss/vite": "^4.1.14",
    "@tanstack/react-table": "^9.1.2",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/nodemailer": "^8.0.1",
    "@types/qrcode": "^1.5.6",
    "@vitejs/plugin-react": "^5.0.4",
    "arabic-persian-reshaper": "^1.0.1",
    "autoprefixer": "^10.4.21",
    "bidi-js": "^1.0.3",
    "dotenv": "^17.2.3",
    "esbuild": "^0.25.0",
    "express": "^4.21.2",
    "firebase": "^12.17.1",
    "firebase-admin": "^14.2.0",
    "html2canvas-pro": "^2.3.5",
    "html2pdf.js": "^0.14.0",
    "jsqr": "^1.4.0",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "nodemailer": "^9.0.5",
    "papaparse": "^5.5.4",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.2.108",
    "qrcode": "^1.5.4",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "react-hot-toast": "^2.6.0",
    "recharts": "^3.10.1",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3",
    "xlsx": "^0.18.5",
    "@vercel/node": "^13.0.1"
  },
  "devDependencies": {
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7"
  }
}
