rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function authEmailLower() {
      return signedIn() && request.auth.token.email != null
        ? request.auth.token.email.lower()
        : '';
    }

    // Must stay aligned with src/config/superAdminAccess.ts SUPER_ADMIN_EMAILS
    function isPlatformSuperAdminEmail() {
      return authEmailLower() == 'admin@aysed.com'
        || authEmailLower() == 'elsayedhr1993@gmail.com'
        || authEmailLower() == 'sayed@hr.com';
    }

    function userDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isSuperAdmin() {
      return signedIn() && (
        isPlatformSuperAdminEmail() ||
        request.auth.token.role == 'SUPER_ADMIN' ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid))
          && userDoc().role == 'SUPER_ADMIN')
      );
    }

    function isCompanyAdmin() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && (userDoc().role == 'COMPANY_ADMIN' || userDoc().role == 'TENANT_ADMIN');
    }

    function profileRole() {
      return exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && userDoc().role is string
        ? userDoc().role
        : (request.auth.token.role is string ? request.auth.token.role : '');
    }

    function isHrManager() {
      return signedIn() && profileRole() == 'HR_MANAGER';
    }

    function isHrUser() {
      return signedIn() && profileRole() == 'HR_USER';
    }

    function isFinance() {
      return signedIn() && profileRole() == 'FINANCE';
    }

    function isDepartmentManager() {
      return signedIn() && (profileRole() == 'DEPARTMENT_MANAGER' || profileRole() == 'DEPT_MANAGER');
    }

    function isEmployeeRole() {
      return signedIn() && profileRole() == 'EMPLOYEE';
    }

    function sameDepartment() {
      return isDepartmentManager()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && 'departmentId' in userDoc()
        && 'departmentId' in resource.data
        && userDoc().departmentId == resource.data.departmentId;
    }

    function ownEmployeeRecord() {
      return signedIn() && (
        ('authUid' in resource.data && resource.data.authUid == request.auth.uid)
        || ('uid' in resource.data && resource.data.uid == request.auth.uid)
        || ('email' in resource.data && resource.data.email is string && resource.data.email.lower() == authEmailLower() && authEmailLower() != '')
      );
    }

    function ownContract() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && 'employeeId' in userDoc()
        && 'employeeId' in resource.data
        && userDoc().employeeId == resource.data.employeeId;
    }

    function payrollRole() {
      return isCompanyAdmin() || isHrManager() || isFinance();
    }

    function hrRead() {
      return isCompanyAdmin() || isHrManager() || isHrUser() || isFinance();
    }

    function hrWrite() {
      return isCompanyAdmin() || isHrManager() || isHrUser();
    }

    function auditRole() {
      return isCompanyAdmin() || isHrManager();
    }

    function ownByEmployeeId() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && 'employeeId' in userDoc()
        && 'employeeId' in resource.data
        && userDoc().employeeId == resource.data.employeeId;
    }

    function incomingOwnEmployee() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && 'employeeId' in userDoc()
        && 'employeeId' in request.resource.data
        && userDoc().employeeId == request.resource.data.employeeId;
    }

    function tokenCompanyId() {
      return request.auth.token.companyId;
    }

    function profileCompanyId() {
      return exists(/databases/$(database)/documents/users/$(request.auth.uid))
        ? (
          ('companyId' in userDoc()
            && userDoc().companyId is string
            && userDoc().companyId != '')
            ? userDoc().companyId
            : (
              ('company_id' in userDoc()
                && userDoc().company_id is string
                && userDoc().company_id != '')
                ? userDoc().company_id
                : (
                  ('activeCompanyId' in userDoc()
                    && userDoc().activeCompanyId is string
                    && userDoc().activeCompanyId != '')
                    ? userDoc().activeCompanyId
                    : null
                )
            )
        )
        : null;
    }

    function callerCompanyId() {
      return tokenCompanyId() != null && tokenCompanyId() != ''
        ? tokenCompanyId()
        : profileCompanyId();
    }

    function systemConfigDocForCaller(docId) {
      return signedIn()
        && callerCompanyId() != null
        && (
          docId == callerCompanyId()
          || docId == 'leave_policy_' + callerCompanyId()
          || docId == 'attendance_policy_' + callerCompanyId()
          || docId == 'public_holidays_' + callerCompanyId()
          || docId == 'attendance_shift_seed_rules_' + callerCompanyId()
          || docId == 'facility_licensing_' + callerCompanyId()
        );
    }

    function canReadSystemConfigDoc(docId) {
      return (systemConfigDocForCaller(docId) && hrRead())
        || (callerCompanyId() != null && isAuthEmailCompanyAdmin(callerCompanyId()));
    }

    function canWriteSystemConfigDoc(docId) {
      return (systemConfigDocForCaller(docId) && isCompanyAdmin())
        || (callerCompanyId() != null && isAuthEmailCompanyAdmin(callerCompanyId()));
    }

    function companyFieldEmailLower(fieldName) {
      return fieldName in resource.data
        && resource.data[fieldName] is string
        && resource.data[fieldName].lower() == authEmailLower()
        && authEmailLower() != '';
    }

    function ownsCompanyRecord() {
      return signedIn() && authEmailLower() != '' && (
        companyFieldEmailLower('adminUsername') ||
        companyFieldEmailLower('email') ||
        companyFieldEmailLower('adminEmail') ||
        companyFieldEmailLower('ownerEmail') ||
        companyFieldEmailLower('contactEmail')
      );
    }

    function companyDocData(companyId) {
      return get(/databases/$(database)/documents/companies/$(companyId)).data;
    }

    function companyDataFieldMatchesAuthEmail(data, fieldName) {
      return fieldName in data
        && data[fieldName] is string
        && data[fieldName].lower() == authEmailLower()
        && authEmailLower() != '';
    }

    // Tenant admin by company record email (works even if users/{uid}.companyId is missing)
    function isAuthEmailCompanyAdmin(companyId) {
      return signedIn()
        && authEmailLower() != ''
        && companyId != null
        && exists(/databases/$(database)/documents/companies/$(companyId))
        && (
          companyDataFieldMatchesAuthEmail(companyDocData(companyId), 'adminUsername') ||
          companyDataFieldMatchesAuthEmail(companyDocData(companyId), 'email') ||
          companyDataFieldMatchesAuthEmail(companyDocData(companyId), 'adminEmail') ||
          companyDataFieldMatchesAuthEmail(companyDocData(companyId), 'ownerEmail') ||
          companyDataFieldMatchesAuthEmail(companyDocData(companyId), 'contactEmail')
        );
    }

    // Align with src/utils/contractTenantRules.ts (URL typos + legacy employee companyId values)
    function canonicalTenantCompanyId(raw) {
      return raw == null || raw == ''
        ? null
        : raw == 'comp-1788142584811' || raw == '1788142584811'
          ? 'comp-1788442584841'
        : raw == '1788442584841' || raw == 'tenant_1788442584841'
          || raw == 'comp-manar' || raw == 'comp-almanar'
          ? 'comp-1788442584841'
        : raw == 'comp-alfanar'
          ? 'tenant_1788413304890'
        : raw == 'comp-elite'
          ? 'comp-1788435917695'
        : raw;
    }

    function callerTenantCanonical() {
      return canonicalTenantCompanyId(callerCompanyId());
    }

    function resourceTenantCanonical() {
      return canonicalTenantCompanyId(resourceCompanyId());
    }

    function resourceCompanyId() {
      return ('companyId' in resource.data
          && resource.data.companyId is string
          && resource.data.companyId != '')
        ? resource.data.companyId
        : (
          ('company_id' in resource.data
            && resource.data.company_id is string
            && resource.data.company_id != '')
            ? resource.data.company_id
            : null
        );
    }

    function incomingCompanyId() {
      return ('companyId' in request.resource.data
          && request.resource.data.companyId is string
          && request.resource.data.companyId != '')
        ? request.resource.data.companyId
        : (
          ('company_id' in request.resource.data
            && request.resource.data.company_id is string
            && request.resource.data.company_id != '')
            ? request.resource.data.company_id
            : null
        );
    }

    function sameTenantResource() {
      return resourceTenantCanonical() != null
        && callerTenantCanonical() != null
        && resourceTenantCanonical() == callerTenantCanonical();
    }

    function incomingTenantCanonical() {
      return canonicalTenantCompanyId(incomingCompanyId());
    }

    function sameTenantIncoming() {
      return incomingTenantCanonical() != null
        && callerTenantCanonical() != null
        && incomingTenantCanonical() == callerTenantCanonical();
    }

    function canReadTenantDoc() {
      return sameTenantResource()
        || (resourceTenantCanonical() != null && isAuthEmailCompanyAdmin(resourceTenantCanonical()));
    }

    function canWriteTenantDoc() {
      return (sameTenantResource() && sameTenantIncoming())
        || (
          resourceTenantCanonical() != null
          && incomingTenantCanonical() != null
          && resourceTenantCanonical() == incomingTenantCanonical()
          && isAuthEmailCompanyAdmin(resourceTenantCanonical())
        );
    }

    function canCreateTenantDoc() {
      return sameTenantIncoming()
        || (incomingTenantCanonical() != null && isAuthEmailCompanyAdmin(incomingTenantCanonical()));
    }

    // User profiles
    match /users/{userId} {
      allow read: if signedIn() && request.auth.uid == userId;
      allow create: if signedIn()
        && request.auth.uid == userId
        && request.resource.data.role != 'SUPER_ADMIN';
      allow update: if signedIn()
        && request.auth.uid == userId
        && (!('role' in request.resource.data)
            || request.resource.data.role == resource.data.role);
      allow delete: if false;
    }

    // Company master records
    match /companies/{companyId} {
      allow read: if isSuperAdmin()
        || (signedIn() && callerCompanyId() == companyId)
        || (isCompanyAdmin() && profileCompanyId() == companyId)
        || ownsCompanyRecord();
      allow write: if isSuperAdmin();

      match /custom_layouts/{screenId} {
        allow read: if (signedIn() && callerCompanyId() == companyId);
        allow write: if false;
      }

      match /ui_overrides/{docId} {
        allow read: if (signedIn() && callerCompanyId() == companyId);
        allow write: if false;
      }

      match /compliance/{complianceDocId} {
        allow read: if (signedIn() && (callerCompanyId() == companyId || isAuthEmailCompanyAdmin(companyId)))
          || ownsCompanyRecord();
        allow create, update: if (signedIn() && (callerCompanyId() == companyId || isAuthEmailCompanyAdmin(companyId))
            && request.resource.data.companyId == companyId);
        allow delete: if false;
      }
    }

    match /dev_companies/{companyId} {
      allow read: if (signedIn() && callerCompanyId() == companyId)
        || ownsCompanyRecord();
      allow write: if false;

      match /ui_overrides/{docId} {
        allow read: if (signedIn() && callerCompanyId() == companyId);
        allow write: if false;
      }
    }

    // SaaS / platform collections — Super Admin only
    match /subscriptions/{docId} {
      allow read, write: if isSuperAdmin();
    }
    match /subscription_requests/{docId} {
      allow read, write: if false;
    }
    match /system_config/{docId} {
      allow read: if canReadSystemConfigDoc(docId);
      allow create, update: if canWriteSystemConfigDoc(docId);
      allow delete: if false;
    }
    match /company_templates/{docId} {
      allow read: if (sameTenantResource() && hrRead())
        || (resourceTenantCanonical() != null && isAuthEmailCompanyAdmin(resourceTenantCanonical()));
      allow create: if (sameTenantIncoming() && hrWrite())
        || (incomingTenantCanonical() != null && isAuthEmailCompanyAdmin(incomingTenantCanonical()));
      allow update, delete: if (canWriteTenantDoc() && hrWrite())
        || (resourceTenantCanonical() != null && isAuthEmailCompanyAdmin(resourceTenantCanonical()));
    }

    // Tenant-scoped operational collections
    match /employees/{docId} {
      allow read: if (sameTenantResource() && (
          isCompanyAdmin() || isHrManager() || isHrUser() || isFinance() || sameDepartment() || ownEmployeeRecord()
        ))
        || (resourceTenantCanonical() != null && isAuthEmailCompanyAdmin(resourceTenantCanonical()));
      allow create: if (sameTenantIncoming() && (isCompanyAdmin() || isHrManager() || isHrUser()))
        || (incomingTenantCanonical() != null && isAuthEmailCompanyAdmin(incomingTenantCanonical()));
      allow update, delete: if (canWriteTenantDoc() && (isCompanyAdmin() || isHrManager() || isHrUser()))
        || (resourceTenantCanonical() != null && isAuthEmailCompanyAdmin(resourceTenantCanonical()));

      match /onboarding/{onboardingDocId} {
        function employeeParentCompanyId() {
          return get(/databases/$(database)/documents/employees/$(docId)).data.companyId;
        }
        allow read: if (signedIn() && (
            callerCompanyId() == employeeParentCompanyId()
            || isAuthEmailCompanyAdmin(employeeParentCompanyId())
          ));
        allow create, update: if (signedIn()
            && callerCompanyId() == employeeParentCompanyId()
            && request.resource.data.companyId == employeeParentCompanyId());
        allow delete: if false;
      }
    }
    match /contracts/{docId} {
      allow read: if (sameTenantResource() && (payrollRole() || isHrUser() || ownContract()))
        || (resourceTenantCanonical() != null && isAuthEmailCompanyAdmin(resourceTenantCanonical()));
      allow create: if (sameTenantIncoming() && (isCompanyAdmin() || isHrManager()))
        || (incomingTenantCanonical() != null && isAuthEmailCompanyAdmin(incomingTenantCanonical()));
      allow update, delete: if (canWriteTenantDoc() && (isCompanyAdmin() || isHrManager()))
        || (resourceTenantCanonical() != null && isAuthEmailCompanyAdmin(resourceTenantCanonical()));
    }
    match /commencements/{docId} {
      allow read: if (sameTenantResource() && hrRead())
        || (resourceTenantCanonical() != null && isAuthEmailCompanyAdmin(resourceTenantCanonical()));
      allow create: if (sameTenantIncoming() && hrWrite())
        || (incomingTenantCanonical() != null && isAuthEmailCompanyAdmin(incomingTenantCanonical()));
      allow update, delete: if (canWriteTenantDoc() && hrWrite())
        || (resourceTenantCanonical() != null && isAuthEmailCompanyAdmin(resourceTenantCanonical()));
    }
    match /leave_requests/{docId} {
      allow read: if (sameTenantResource() && (hrRead() || sameDepartment() || ownByEmployeeId()))
        || (resourceTenantCanonical() != null && isAuthEmailCompanyAdmin(resourceTenantCanonical()));
      allow create: if (sameTenantIncoming() && (hrWrite() || incomingOwnEmployee()))
        || (incomingTenantCanonical() != null && isAuthEmailCompanyAdmin(incomingTenantCanonical()));
      allow update, delete: if (canWriteTenantDoc() && (hrWrite() || ownByEmployeeId()))
        || (resourceTenantCanonical() != null && isAuthEmailCompanyAdmin(resourceTenantCanonical()));
    }
    match /leave_allocations/{docId} {
      allow read: if (sameTenantResource() && (hrRead() || sameDepartment() || ownByEmployeeId()))
        || (resourceTenantCanonical() != null && isAuthEmailCompanyAdmin(resourceTenantCanonical()));
      allow create: if (sameTenantIncoming() && hrWrite())
        || (incomingTenantCanonical() != null && isAuthEmailCompanyAdmin(incomingTenantCanonical()));
      allow update, delete: if (canWriteTenantDoc() && hrWrite())
        || (resourceTenantCanonical() != null && isAuthEmailCompanyAdmin(resourceTenantCanonical()));
    }
    match /leave_settlements/{docId} {
      allow read: if (sameTenantResource() && payrollRole())
        || (resourceTenantCanonical() != null && isAuthEmailCompanyAdmin(resourceTenantCanonical()));
      allow create: if (sameTenantIncoming() && payrollRole())
        || (incomingTenantCanonical() != null && isAuthEmailCompanyAdmin(incomingTenantCanonical()));
      allow update, delete: if (canWriteTenantDoc() && payrollRole())
        || (resourceTenantCanonical() != null && isAuthEmailCompanyAdmin(resourceTenantCanonical()));
    }
    match /onboarding_plans/{docId} {
      allow read: if (sameTenantResource() && hrRead())
        || (resourceTenantCanonical() != null && isAuthEmailCompanyAdmin(resourceTenantCanonical()));
      allow create: if (sameTenantIncoming() && hrWrite())
        || (incomingTenantCanonical() != null && isAuthEmailCompanyAdmin(incomingTenantCanonical()));
      allow update, delete: if (canWriteTenantDoc() && hrWrite())
        || (resourceTenantCanonical() != null && isAuthEmailCompanyAdmin(resourceTenantCanonical()));
    }
    match /documents/{docId} {
      allow read: if (sameTenantResource() && hrRead())
        || (resourceTenantCanonical() != null && isAuthEmailCompanyAdmin(resourceTenantCanonical()));
      allow create: if (sameTenantIncoming() && hrWrite())
        || (incomingTenantCanonical() != null && isAuthEmailCompanyAdmin(incomingTenantCanonical()));
      allow update, delete: if (canWriteTenantDoc() && hrWrite())
        || (resourceTenantCanonical() != null && isAuthEmailCompanyAdmin(resourceTenantCanonical()));
    }
    match /company_documents/{docId} {
      allow read: if (sameTenantResource() && hrRead())
        || (resourceTenantCanonical() != null && isAuthEmailCompanyAdmin(resourceTenantCanonical()));
      allow create: if (sameTenantIncoming() && hrWrite())
        || (incomingTenantCanonical() != null && isAuthEmailCompanyAdmin(incomingTenantCanonical()));
      allow update, delete: if (canWriteTenantDoc() && hrWrite())
        || (resourceTenantCanonical() != null && isAuthEmailCompanyAdmin(resourceTenantCanonical()));
    }
    match /payslips/{docId} {
      allow read: if (sameTenantResource() && payrollRole())
        || (resourceTenantCanonical() != null && isAuthEmailCompanyAdmin(resourceTenantCanonical()));
      allow create: if (sameTenantIncoming() && payrollRole())
        || (incomingTenantCanonical() != null && isAuthEmailCompanyAdmin(incomingTenantCanonical()));
      allow update, delete: if (canWriteTenantDoc() && payrollRole())
        || (resourceTenantCanonical() != null && isAuthEmailCompanyAdmin(resourceTenantCanonical()));
    }
    match /attendance_records/{docId} {
      allow read: if (sameTenantResource() && (hrRead() || sameDepartment()))
        || (resourceTenantCanonical() != null && isAuthEmailCompanyAdmin(resourceTenantCanonical()));
      allow create: if (sameTenantIncoming() && hrWrite())
        || (incomingTenantCanonical() != null && isAuthEmailCompanyAdmin(incomingTenantCanonical()));
      allow update, delete: if (canWriteTenantDoc() && hrWrite())
        || (resourceTenantCanonical() != null && isAuthEmailCompanyAdmin(resourceTenantCanonical()));
    }
    match /attendance/{docId} {
      allow read: if (sameTenantResource() && (hrRead() || sameDepartment()))
        || (resourceTenantCanonical() != null && isAuthEmailCompanyAdmin(resourceTenantCanonical()));
      allow create: if (sameTenantIncoming() && hrWrite())
        || (incomingTenantCanonical() != null && isAuthEmailCompanyAdmin(incomingTenantCanonical()));
      allow update, delete: if (canWriteTenantDoc() && hrWrite())
        || (resourceTenantCanonical() != null && isAuthEmailCompanyAdmin(resourceTenantCanonical()));
    }
    match /work_entries/{docId} {
      allow read: if (sameTenantResource() && (hrRead() || sameDepartment()))
        || (resourceTenantCanonical() != null && isAuthEmailCompanyAdmin(resourceTenantCanonical()));
      allow create: if (sameTenantIncoming() && hrWrite())
        || (incomingTenantCanonical() != null && isAuthEmailCompanyAdmin(incomingTenantCanonical()));
      allow update, delete: if (canWriteTenantDoc() && hrWrite())
        || (resourceTenantCanonical() != null && isAuthEmailCompanyAdmin(resourceTenantCanonical()));
    }
    match /employee_lifecycle_events/{docId} {
      allow read: if (sameTenantResource() && hrRead())
        || (resourceTenantCanonical() != null && isAuthEmailCompanyAdmin(resourceTenantCanonical()));
      allow create: if (sameTenantIncoming() && hrWrite())
        || (incomingTenantCanonical() != null && isAuthEmailCompanyAdmin(incomingTenantCanonical()));
      allow update, delete: if (canWriteTenantDoc() && hrWrite())
        || (resourceTenantCanonical() != null && isAuthEmailCompanyAdmin(resourceTenantCanonical()));
    }
    function isPlatformAuditLog() {
      return !('companyId' in resource.data)
        || resource.data.companyId == null
        || resource.data.companyId == ''
        || resource.data.companyId == 'platform';
    }

    match /audit_logs/{docId} {
      allow read: if (sameTenantResource() && (isCompanyAdmin() || isHrManager()))
        || (isSuperAdmin() && isPlatformAuditLog());
      allow create, update, delete: if false;
    }

    match /platform_users/{userId} {
      allow read, write: if isSuperAdmin();
    }
    match /work_on_holidays/{docId} {
      allow read: if (sameTenantResource() && (hrRead() || sameDepartment()))
        || (resourceTenantCanonical() != null && isAuthEmailCompanyAdmin(resourceTenantCanonical()));
      allow create: if (sameTenantIncoming() && hrWrite())
        || (incomingTenantCanonical() != null && isAuthEmailCompanyAdmin(incomingTenantCanonical()));
      allow update, delete: if (canWriteTenantDoc() && hrWrite())
        || (resourceTenantCanonical() != null && isAuthEmailCompanyAdmin(resourceTenantCanonical()));
    }
    match /loans/{docId} {
      allow read: if (sameTenantResource() && payrollRole())
        || (resourceTenantCanonical() != null && isAuthEmailCompanyAdmin(resourceTenantCanonical()));
      allow create: if (sameTenantIncoming() && payrollRole())
        || (incomingTenantCanonical() != null && isAuthEmailCompanyAdmin(incomingTenantCanonical()));
      allow update, delete: if (canWriteTenantDoc() && payrollRole())
        || (resourceTenantCanonical() != null && isAuthEmailCompanyAdmin(resourceTenantCanonical()));
    }
    match /custodies/{docId} {
      allow read: if (sameTenantResource() && hrRead())
        || (resourceTenantCanonical() != null && isAuthEmailCompanyAdmin(resourceTenantCanonical()));
      allow create: if (sameTenantIncoming() && hrWrite())
        || (incomingTenantCanonical() != null && isAuthEmailCompanyAdmin(incomingTenantCanonical()));
      allow update, delete: if (canWriteTenantDoc() && hrWrite())
        || (resourceTenantCanonical() != null && isAuthEmailCompanyAdmin(resourceTenantCanonical()));
    }
    match /candidates/{docId} {
      allow read: if (sameTenantResource() && hrRead())
        || (resourceTenantCanonical() != null && isAuthEmailCompanyAdmin(resourceTenantCanonical()));
      allow create: if (sameTenantIncoming() && hrWrite())
        || (incomingTenantCanonical() != null && isAuthEmailCompanyAdmin(incomingTenantCanonical()));
      allow update, delete: if (canWriteTenantDoc() && hrWrite())
        || (resourceTenantCanonical() != null && isAuthEmailCompanyAdmin(resourceTenantCanonical()));
    }
    match /facility_alerts/{docId} {
      allow read: if (sameTenantResource() && (auditRole() || isHrUser()))
        || (resourceTenantCanonical() != null && isAuthEmailCompanyAdmin(resourceTenantCanonical()));
      allow create: if (sameTenantIncoming() && auditRole())
        || (incomingTenantCanonical() != null && isAuthEmailCompanyAdmin(incomingTenantCanonical()));
      allow update, delete: if (canWriteTenantDoc() && auditRole())
        || (resourceTenantCanonical() != null && isAuthEmailCompanyAdmin(resourceTenantCanonical()));
    }
    match /biometric_devices/{docId} {
      allow read: if (sameTenantResource() && hrRead())
        || (resourceTenantCanonical() != null && isAuthEmailCompanyAdmin(resourceTenantCanonical()));
      allow create: if (sameTenantIncoming() && hrWrite())
        || (incomingTenantCanonical() != null && isAuthEmailCompanyAdmin(incomingTenantCanonical()));
      allow update, delete: if (canWriteTenantDoc() && hrWrite())
        || (resourceTenantCanonical() != null && isAuthEmailCompanyAdmin(resourceTenantCanonical()));
    }

    // No recursive allow. A collection without an explicit allow is denied.
  }
}
