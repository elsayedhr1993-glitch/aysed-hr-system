{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "installCommand": "npm install",
  "functions": {
    "api/ai-chat.ts": {
      "maxDuration": 60,
      "memory": 1024,
      "includeFiles": "api/_bundles/ai-chat.cjs"
    },
    "api/ai/test-key.ts": {
      "maxDuration": 60,
      "memory": 1024,
      "includeFiles": "api/_bundles/test-key.cjs"
    }
  },
  "rewrites": [{ "source": "/((?!assets/|api/).*)", "destination": "/index.html" }]
}
